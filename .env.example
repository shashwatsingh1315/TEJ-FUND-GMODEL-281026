# Add these to Vercel project environment variables. Never commit real keys.
CLERK_PUBLISHABLE_KEY=
# Vercel's Clerk integration may supply NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY instead;
# the server supports either name.
CLERK_SECRET_KEY=
# Exact public origin of production/local deployment (no path). Vercel previews
# use Vercel's own VERCEL_URL automatically.
APP_ORIGIN=https://tejas-growth-model.vercel.app
# Copy the hosted Account Portal sign-in URL from your Clerk application.
# Keep this hosted URL for recovery fallback and backend SDK configuration;
# normal account access uses this project's /sign-up and /sign-in pages.
CLERK_SIGN_IN_URL=
# Optional comma-separated origins allowed to issue session tokens for this app.
# Defaults to APP_ORIGIN. Configure previews with their own test instance/keys.
CLERK_AUTHORIZED_PARTIES=https://tejas-growth-model.vercel.app
# Optional Clerk PEM public key for networkless JWT signature verification.
CLERK_JWT_KEY=
# Optional exact email addresses allowed after Clerk verifies the primary email.
# Keep actual recipients in Vercel environment settings, not source code.
DASHBOARD_ALLOWED_EMAILS=
# restricted (default): invitation grant or verified primary email allowlist.
# authenticated: every signed-in user, unless explicitly blocked/banned/locked.
# Set per Vercel project; never put a permissive default in shared code.
DASHBOARD_ACCESS_MODE=restricted
